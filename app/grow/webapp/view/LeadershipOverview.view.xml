<mvc:View
  controllerName="com.ey.grow.prototype.controller.LeadershipOverview"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:layout="sap.ui.layout"
  displayBlock="true">
  <Page id="leadershipPage" title="Executive Transformation Overview" showNavButton="false">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <Toolbar design="Transparent" class="sapUiTinyMarginBottom">
          <Title text="GROW Automation Executive Overview" level="H1"/>
          <ToolbarSpacer/>
          <Button text="Value impact" press=".onValueImpact"/>
          <Button text="Risk board" press=".onRiskBoard"/>
          <Button text="Operating readiness" press=".onOperatingReadiness"/>
        </Toolbar>

        <layout:ResponsiveFlowLayout>
          <VBox class="sapUiSmallMarginEnd" width="18%">
            <GenericTile header="Program health" subheader="82%" press=".onValueImpact">
              <TileContent>
                <NumericContent value="82" valueColor="Good" scale="%"/>
              </TileContent>
            </GenericTile>
          </VBox>
          <VBox class="sapUiSmallMarginEnd" width="18%">
            <GenericTile header="Value realized" subheader="$4.2M" press=".onValueImpact">
              <TileContent>
                <NumericContent value="4.2" scale="M" valueColor="Good"/>
              </TileContent>
            </GenericTile>
          </VBox>
          <VBox class="sapUiSmallMarginEnd" width="18%">
            <GenericTile header="Risk posture" subheader="Low-medium" press=".onRiskBoard">
              <TileContent>
                <NumericContent value="12" scale="%" valueColor="Critical"/>
              </TileContent>
            </GenericTile>
          </VBox>
          <VBox class="sapUiSmallMarginEnd" width="18%">
            <GenericTile header="Deployment confidence" subheader="94%" press=".onOperatingReadiness">
              <TileContent>
                <NumericContent value="94" scale="%" valueColor="Good"/>
              </TileContent>
            </GenericTile>
          </VBox>
          <VBox width="18%">
            <GenericTile header="Governance coverage" subheader="96%" press=".onRiskBoard">
              <TileContent>
                <NumericContent value="96" scale="%" valueColor="Good"/>
              </TileContent>
            </GenericTile>
          </VBox>
        </layout:ResponsiveFlowLayout>

        <HBox width="100%" class="sapUiMediumMarginTop">
          <VBox width="60%" class="sapUiSmallMarginEnd">
            <Panel headerText="Transformation momentum" class="sapUiSmallMarginBottom">
              <VBox class="sapUiSmallMargin">
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                  <Text text="Implementation readiness"/>
                  <ObjectStatus text="On track" state="Success"/>
                </HBox>
                <ProgressIndicator percentValue="82" displayValue="82%" state="Success"/>
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginTop">
                  <Text text="Business-process alignment"/>
                  <ObjectStatus text="Aligned" state="Success"/>
                </HBox>
                <ProgressIndicator percentValue="89" displayValue="89%" state="Success"/>
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginTop">
                  <Text text="Deployment exception exposure"/>
                  <ObjectStatus text="Contained" state="Warning"/>
                </HBox>
                <ProgressIndicator percentValue="26" displayValue="26%" state="Warning"/>
              </VBox>
            </Panel>
          </VBox>

          <VBox width="40%">
            <Panel headerText="Leadership decisions required">
              <List>
                <StandardListItem title="Approve control framework" description="Risk posture within policy guardrails"/>
                <StandardListItem title="Release configuration package" description="Only 2 blockers remain"/>
                <StandardListItem title="Confirm support model" description="Operational ownership assigned"/>
              </List>
            </Panel>
          </VBox>
        </HBox>

        <Panel headerText="Program narrative" class="sapUiMediumMarginTop">
          <VBox class="sapUiSmallMargin">
            <Text text="The transformation program has moved beyond discovery and is now demonstrating measurable control, evidence-backed execution, and a disciplined governance model. Core change design is complete, with risk exposure reduced through policy controls, simulated deployment verification, and structured exception recovery."/>
            <Text class="sapUiTinyMarginTop" text="The current trajectory supports a controlled scale-up with executive confidence based on traceability, readiness, and controlled automation."/>
          </VBox>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
