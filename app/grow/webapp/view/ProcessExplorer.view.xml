<mvc:View
  controllerName="com.ey.grow.prototype.controller.ProcessExplorer"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="processPage" title="Process and architecture explorer" showNavButton="true" navButtonPress=".onBack" class="boardroom-page">
    <content>
      <VBox class="sapUiSmallMargin boardroom-shell" width="100%">
        <ObjectHeader
          title="{project>/projectName}"
          number="{project>/projectId}"
          intro="Review business process scope candidates and support system relationships before the final recommendation is approved."
          backgroundDesign="Solid"/>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Select domain or process" press=".onSelectDomainOrProcess"/>
          <Button text="View process flow" press=".onViewProcessFlow"/>
          <Button text="Inspect application relation" press=".onInspectApplicationRelation"/>
          <Button text="Add to review" type="Emphasized" press=".onAddToReview"/>
        </Toolbar>

        <HBox class="sapUiMediumMarginTop" width="100%">
          <VBox width="45%" class="sapUiSmallMarginEnd boardroom-panel">
            <Panel headerText="Process catalog">
              <List id="processList" items="{process>/items}" mode="SingleSelectMaster" selectionChange=".onProcessSelect" class="sapUiTinyMarginTop">
                <items>
                  <StandardListItem
                    title="{process>label}"
                    description="{process>domain}"
                    info="{process>status}"
                    type="Active"/>
                </items>
              </List>
            </Panel>
          </VBox>

          <VBox width="55%" class="boardroom-panel">
            <Panel headerText="Selected process context">
              <VBox class="sapUiSmallMargin">
                <HBox>
                  <Label text="Domain" class="sapUiTinyMarginEnd"/>
                  <Text text="{process>/selected/domain}"/>
                </HBox>
                <HBox class="sapUiTinyMarginTop">
                  <Label text="BR / TC" class="sapUiTinyMarginEnd"/>
                  <Text text="{process>/selected/brTc}"/>
                </HBox>
                <HBox class="sapUiTinyMarginTop">
                  <Label text="Supporting system" class="sapUiTinyMarginEnd"/>
                  <Text text="{process>/selected/system}"/>
                </HBox>
                <HBox class="sapUiTinyMarginTop">
                  <Label text="Scope candidates" class="sapUiTinyMarginEnd"/>
                  <Text text="{process>/selected/scopeCandidates}"/>
                </HBox>
              </VBox>
            </Panel>
          </VBox>
        </HBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
