<mvc:View
  controllerName="com.ey.grow.prototype.controller.ScopeReview"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="scopeReviewPage" title="Scoping agent review" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <ObjectHeader
          title="{project>/projectName}"
          number="{project>/projectId}"
          intro="Review grounded scope candidates, exclusion risks and prerequisites before baselining the proposed scope."
          backgroundDesign="Solid"/>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Generate proposal" press=".onGenerateProposal"/>
          <Button text="Select candidate" press=".onSelectCandidate"/>
          <Button text="Accept or exclude" press=".onAcceptOrExclude"/>
          <Button text="Compare versions" press=".onCompareVersions"/>
          <Button text="Submit scope baseline" type="Emphasized" press=".onSubmitScopeBaseline"/>
        </Toolbar>

        <Table id="scopeTable" items="{scope>/items}" class="sapUiSmallMarginTop">
          <columns>
            <Column width="180px"><Text text="SAP ID"/></Column>
            <Column width="180px"><Text text="Candidate"/></Column>
            <Column width="150px"><Text text="Status"/></Column>
            <Column width="140px"><Text text="Coverage"/></Column>
            <Column><Text text="Prerequisites"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press=".onSelectScopeRow">
              <cells>
                <Text text="{scope>sapId}"/>
                <Text text="{scope>candidate}"/>
                <ObjectStatus text="{scope>status}" state="{scope>state}"/>
                <Text text="{scope>coverage}"/>
                <Text text="{scope>prerequisites}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
