<mvc:View
  controllerName="com.ey.grow.prototype.controller.ReconciliationWorkspace"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="reconciliationPage" title="Readback and reconciliation" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <ObjectHeader
          title="{reconcile>/packageName}"
          number="{reconcile>/packageId}"
          intro="Distinguish approved intent, simulated target observations and verified completion before closing the deployment path."
          backgroundDesign="Solid">
          <statuses>
            <ObjectStatus text="{reconcile>/readbackStatus}" state="{reconcile>/readbackState}"/>
          </statuses>
        </ObjectHeader>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Refresh observation" press=".onRefreshObservation"/>
          <Button text="Inspect difference" press=".onInspectDifference"/>
          <Button text="Create recovery task" press=".onCreateRecoveryTask"/>
          <Button text="Accept verified completion" type="Emphasized" press=".onAcceptVerifiedCompletion"/>
          <Button text="Export reconciliation" press=".onExportReconciliation"/>
        </Toolbar>

        <MessageStrip
          class="sapUiSmallMarginTopBottom"
          type="{reconcile>/bannerType}"
          showIcon="true"
          text="{reconcile>/bannerText}"/>

        <HBox width="100%" class="sapUiSmallMarginTop">
          <VBox width="55%" class="sapUiSmallMarginEnd">
            <Panel headerText="Approved vs observed values" expandable="false">
              <Table id="reconcileTable" items="{reconcile>/differences}" mode="SingleSelectMaster" selectionChange=".onSelectDifference">
                <columns>
                  <Column width="180px"><Text text="Field"/></Column>
                  <Column width="180px"><Text text="Approved"/></Column>
                  <Column width="180px"><Text text="Observed"/></Column>
                  <Column><Text text="Impact"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{reconcile>field}"/>
                      <Text text="{reconcile>approved}"/>
                      <Text text="{reconcile>observed}"/>
                      <ObjectStatus text="{reconcile>impact}" state="{reconcile>impactState}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </Panel>
          </VBox>

          <VBox width="45%">
            <Panel headerText="Selected difference">
              <VBox class="sapUiSmallMargin">
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                  <Text text="Field"/>
                  <Text text="{reconcile>/selection/field}"/>
                </HBox>
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                  <Text text="Approved value"/>
                  <Text text="{reconcile>/selection/approved}"/>
                </HBox>
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                  <Text text="Observed value"/>
                  <Text text="{reconcile>/selection/observed}"/>
                </HBox>
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                  <Text text="Timestamp"/>
                  <Text text="{reconcile>/selection/timestamp}"/>
                </HBox>
                <Text text="Affected requirements:" class="sapUiTinyMarginTop"/>
                <List items="{reconcile>/selection/requirements}">
                  <items>
                    <StandardListItem title="{reconcile>}"/>
                  </items>
                </List>
              </VBox>
            </Panel>
          </VBox>
        </HBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
