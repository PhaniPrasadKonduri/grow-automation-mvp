<mvc:View
  controllerName="com.ey.grow.prototype.controller.QualityValidationWorkspace"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="qualityPage" title="Realize Test and qualification" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <ObjectHeader
          title="{quality>/projectName}"
          number="{quality>/projectId}"
          intro="Demonstrate product qualification and selected pilot scenarios without claiming future full process automation."
          backgroundDesign="Solid"/>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Run demo suite" press=".onRunDemoSuite"/>
          <Button text="Inspect failure" press=".onInspectFailure"/>
          <Button text="Record UAT result" press=".onRecordUATResult"/>
          <Button text="Create ALM task" press=".onCreateALMTask"/>
          <Button text="Request quality gate" type="Emphasized" press=".onRequestQualityGate"/>
        </Toolbar>

        <MessageStrip
          class="sapUiSmallMarginTopBottom"
          type="{quality>/bannerType}"
          showIcon="true"
          text="{quality>/bannerText}"/>

        <Table id="qualityTable" items="{quality>/tests}" mode="SingleSelectMaster" selectionChange=".onSelectTest">
          <columns>
            <Column width="170px"><Text text="Feature"/></Column>
            <Column width="160px"><Text text="Test case"/></Column>
            <Column width="130px"><Text text="Result"/></Column>
            <Column><Text text="Evidence"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{quality>feature}"/>
                <Text text="{quality>caseId}"/>
                <ObjectStatus text="{quality>result}" state="{quality>resultState}"/>
                <Text text="{quality>evidence}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
