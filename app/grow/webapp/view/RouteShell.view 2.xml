<mvc:View
  controllerName="com.ey.grow.prototype.controller.RouteShell"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true">
  <Page id="routeShellPage" title="{screen>/screenInfo/title}" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%" alignItems="Stretch">
        <Title text="{screen>/screenInfo/title}" level="H1"/>
        <Text text="{screen>/screenInfo/purpose}"/>
        <Toolbar class="sapUiTinyMarginTop">
          <ToolbarSpacer/>
          <Button text="Home" press=".onHome"/>
        </Toolbar>
        <List items="{screen>/screenInfo/actions}">
          <items>
            <StandardListItem
              title="{screen>label}"
              description="{screen>description}"
              type="Inactive"/>
          </items>
        </List>
      </VBox>
    </content>
  </Page>
</mvc:View>
