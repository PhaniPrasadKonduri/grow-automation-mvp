<mvc:View
  controllerName="com.ey.grow.prototype.controller.ArchitectureAndApplicationMap"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="architecturePage" title="Architecture and application map" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <ObjectHeader
          title="{arch>/projectName}"
          number="{arch>/projectId}"
          intro="Connect process context to applications, capabilities and the mapped implementation scope while keeping the view read-only and demonstrative."
          backgroundDesign="Solid"/>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Select relation" press=".onSelectRelation"/>
          <Button text="Open Signavio context" press=".onOpenSignavioContext"/>
          <Button text="Open LeanIX context" press=".onOpenLeanIxContext"/>
          <Button text="Assess impact" press=".onAssessImpact"/>
          <Button text="Refresh mapped context" type="Emphasized" press=".onRefreshMappedContext"/>
        </Toolbar>

        <MessageStrip
          class="sapUiSmallMarginTopBottom"
          type="{arch>/bannerType}"
          showIcon="true"
          text="{arch>/bannerText}"/>

        <HBox width="100%" class="sapUiSmallMarginTop">
          <VBox width="45%" class="sapUiSmallMarginEnd">
            <Panel headerText="Architecture relations">
              <List items="{arch>/relations}" mode="SingleSelectMaster" selectionChange=".onSelectRelationItem">
                <items>
                  <StandardListItem
                    title="{arch>label}"
                    description="{arch>domain}"
                    info="{arch>status}" />
                </items>
              </List>
            </Panel>
          </VBox>

          <VBox width="55%">
            <Panel headerText="Selected relation">
              <VBox class="sapUiSmallMargin">
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                  <Text text="Relation"/>
                  <Text text="{arch>/selected/label}"/>
                </HBox>
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                  <Text text="Lifecycle"/>
                  <Text text="{arch>/selected/lifecycle}"/>
                </HBox>
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                  <Text text="Owner"/>
                  <Text text="{arch>/selected/owner}"/>
                </HBox>
                <Text text="Impact summary:" class="sapUiTinyMarginTop"/>
                <Text text="{arch>/selected/impact}"/>
              </VBox>
            </Panel>
          </VBox>
        </HBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
