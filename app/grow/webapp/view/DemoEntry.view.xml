<mvc:View
  controllerName="com.ey.grow.prototype.controller.DemoEntry"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page title="Demo entry and role context" showHeader="true">
    <content>
      <VBox class="sapUiSmallMargin" width="100%" alignItems="Stretch">
        <Title text="GROW demo entry" level="H1"/>
        <Text text="Choose a seeded persona, a scenario and confirm the starting state before entering the guided journey."/>

        <HBox class="sapUiTinyMarginTop" alignItems="Center">
          <Label text="Persona" class="sapUiSmallMarginEnd" width="120px"/>
          <Select id="personaSelect" width="300px">
            <core:Item key="sponsor" text="Sponsor"/>
            <core:Item key="deliveryLead" text="Delivery Lead"/>
            <core:Item key="analyst" text="Analyst"/>
            <core:Item key="functionalConsultant" text="Functional Consultant"/>
            <core:Item key="configurationConsultant" text="Configuration Consultant"/>
            <core:Item key="financeApprover" text="Finance Approver"/>
            <core:Item key="releaseManager" text="Release Manager"/>
          </Select>
        </HBox>

        <HBox class="sapUiTinyMarginTop" alignItems="Center">
          <Label text="Scenario" class="sapUiSmallMarginEnd" width="120px"/>
          <Select id="scenarioSelect" width="300px">
            <core:Item key="happy-path" text="Happy path"/>
            <core:Item key="exception" text="Exception path"/>
          </Select>
        </HBox>

        <HBox class="sapUiTinyMarginTop">
          <Button id="startTourBtn" type="Emphasized" text="Start guided tour" press=".onStartTour"/>
          <Button id="resetBtn" text="Reset scenario" class="sapUiSmallMarginBegin" press=".onResetScenario"/>
        </HBox>

        <Panel headerText="Selected context" class="sapUiSmallMarginTop">
          <VBox>
            <Text id="selectedPersonaText" text="Selected persona: Sponsor"/>
            <Text id="selectedScenarioText" text="Selected scenario: Happy path"/>
            <Text id="contextSummaryText" text="This demo keeps the project and policy context local to the synthetic GROW workspace."/>
          </VBox>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
