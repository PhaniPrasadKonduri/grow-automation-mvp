<mvc:View
  controllerName="com.ey.grow.prototype.controller.OrganizationDesigner"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="orgDesignerPage" title="Organization structure designer" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <ObjectHeader
          title="{project>/projectName}"
          number="{project>/projectId}"
          intro="Design and validate the legal and operating structure across the planned countries and ownership model."
          backgroundDesign="Solid"/>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Select node" press=".onSelectNode"/>
          <Button text="Add node or assignment" press=".onAddNodeOrAssignment"/>
          <Button text="Generate design" press=".onGenerateDesign"/>
          <Button text="Validate structure" press=".onValidateStructure"/>
          <Button text="Submit structure" type="Emphasized" press=".onSubmitStructure"/>
        </Toolbar>

        <HBox class="sapUiSmallMarginTop" width="100%">
          <VBox width="40%" class="sapUiSmallMarginEnd">
            <Title text="Design tree" level="H3"/>
            <Tree id="orgTree" items="{org>/nodes}" mode="SingleSelectMaster" selectionChange=".onSelectNodeFromTree">
              <items>
                <StandardTreeItem title="{org>label}" description="{org>type}"/>
              </items>
            </Tree>
          </VBox>

          <VBox width="60%">
            <Title text="Selected node" level="H3"/>
            <Panel headerText="{org>/selected/label}" class="sapUiSmallMarginTop">
              <content>
                <VBox class="sapUiTinyMargin">
                  <HBox>
                    <Label text="Type" class="sapUiTinyMarginEnd"/>
                    <Text text="{org>/selected/type}"/>
                  </HBox>
                  <HBox class="sapUiTinyMarginTop">
                    <Label text="Country" class="sapUiTinyMarginEnd"/>
                    <Text text="{org>/selected/country}"/>
                  </HBox>
                  <HBox class="sapUiTinyMarginTop">
                    <Label text="Assignments" class="sapUiTinyMarginEnd"/>
                    <Text text="{org>/selected/assignments}"/>
                  </HBox>
                  <HBox class="sapUiTinyMarginTop">
                    <Label text="Parent" class="sapUiTinyMarginEnd"/>
                    <Text text="{org>/selected/parent}"/>
                  </HBox>
                </VBox>
              </content>
            </Panel>
          </VBox>
        </HBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
