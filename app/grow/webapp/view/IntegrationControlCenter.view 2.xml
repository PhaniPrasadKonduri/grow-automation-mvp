<mvc:View
  controllerName="com.ey.grow.prototype.controller.IntegrationControlCenter"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="integrationPage" title="Integration control center" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <ObjectHeader
          title="{project>/projectName}"
          number="{project>/projectId}"
          intro="Five SAP integration touchpoints with correlation, capability status and observed freshness."
          backgroundDesign="Solid"/>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Test connection" press=".onTestConnection"/>
          <Button text="View contract" press=".onViewContract"/>
          <Button text="Refresh snapshot" press=".onRefreshSnapshot"/>
          <Button text="Inspect failed exchange" press=".onInspectFailedExchange"/>
          <Button text="Open SAP reference" press=".onOpenSapReference"/>
        </Toolbar>

        <Table id="integrationTable" items="{integration>/items}" class="sapUiTinyMarginTop">
          <columns>
            <Column width="160px"><Text text="System"/></Column>
            <Column width="180px"><Text text="Capability"/></Column>
            <Column width="150px"><Text text="Observed"/></Column>
            <Column width="160px"><Text text="Status"/></Column>
            <Column><Text text="Correlation"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press=".onSelectIntegration">
              <cells>
                <Text text="{integration>system}"/>
                <Text text="{integration>capability}"/>
                <Text text="{integration>observedAt}"/>
                <ObjectStatus text="{integration>status}" state="{integration>state}"/>
                <Text text="{integration>correlationId}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
