<mvc:View
  controllerName="com.ey.grow.prototype.controller.ValueAndImpact"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="valuePage" title="Value and impact" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <ObjectHeader
          title="{value>/headline}"
          number="{value>/projectId}"
          intro="Connect business value assumptions to project progress, observed outcomes and the remaining pilot risk."
          backgroundDesign="Solid"/>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Inspect metric" press=".onInspectMetric"/>
          <Button text="Edit planning assumption" press=".onEditPlanningAssumption"/>
          <Button text="Compare journey" press=".onCompareJourney"/>
          <Button text="Export executive summary" type="Emphasized" press=".onExportExecutiveSummary"/>
        </Toolbar>

        <MessageStrip
          class="sapUiSmallMarginTopBottom"
          type="{value>/bannerType}"
          showIcon="true"
          text="{value>/bannerText}"/>

        <HBox width="100%" class="sapUiSmallMarginTop">
          <VBox width="50%" class="sapUiSmallMarginEnd">
            <Panel headerText="Benefit indicators">
              <List items="{value>/metrics}">
                <CustomListItem>
                  <HBox justifyContent="SpaceBetween" class="sapUiSmallMargin">
                    <Text text="{value>label}"/>
                    <ObjectStatus text="{value>value}" state="{value>state}"/>
                  </HBox>
                </CustomListItem>
              </List>
            </Panel>
          </VBox>

          <VBox width="50%">
            <Panel headerText="Scenario comparison">
              <Table items="{value>/scenarios}">
                <columns>
                  <Column><Text text="Scenario"/></Column>
                  <Column><Text text="Effort"/></Column>
                  <Column><Text text="Quality"/></Column>
                  <Column><Text text="Benefit"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{value>scenario}"/>
                      <Text text="{value>effort}"/>
                      <Text text="{value>quality}"/>
                      <ObjectStatus text="{value>benefit}" state="{value>benefitState}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </Panel>
          </VBox>
        </HBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
