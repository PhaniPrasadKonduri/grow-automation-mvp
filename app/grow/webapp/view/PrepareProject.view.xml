<mvc:View
  controllerName="com.ey.grow.prototype.controller.PrepareProject"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="preparePage" title="Prepare and project setup" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <ObjectHeader
          title="{project>/projectName}"
          number="{project>/projectId}"
          intro="Establish ownership, legal entities, countries and target setup before executing the proposal."
          backgroundDesign="Solid"/>

        <HBox class="sapUiTinyMarginTop" alignItems="Center">
          <Label text="Project name" class="sapUiSmallMarginEnd" width="140px"/>
          <Input id="projectNameInput" value="{project>/projectName}" width="320px"/>
        </HBox>

        <HBox class="sapUiTinyMarginTop" alignItems="Center">
          <Label text="Target country" class="sapUiSmallMarginEnd" width="140px"/>
          <Select selectedKey="{project>/country}" width="220px">
            <items>
              <core:Item key="DE" text="Germany"/>
              <core:Item key="US" text="United States"/>
              <core:Item key="FR" text="France"/>
            </items>
          </Select>
        </HBox>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Edit project" press=".onEditProject"/>
          <Button text="Legal entities" press=".onOpenLegalEntities"/>
          <Button text="Assign owners" press=".onAssignOwners"/>
          <Button text="Readiness check" type="Emphasized" press=".onReadinessCheck"/>
        </Toolbar>

        <Table items="{project>/legalEntities}" headerText="Legal entities" class="sapUiTinyMarginTop">
          <columns>
            <Column><Text text="Entity ID"/></Column>
            <Column><Text text="Country"/></Column>
            <Column><Text text="Status"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{project>id}"/>
                <Text text="{project>country}"/>
                <ObjectStatus text="{project>status}" state="{project>state}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
