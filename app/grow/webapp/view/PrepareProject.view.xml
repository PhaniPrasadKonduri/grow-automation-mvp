<mvc:View
  controllerName="com.ey.grow.prototype.controller.PrepareProject"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="preparePage" title="Prepare and project setup" showNavButton="true" navButtonPress=".onBack" class="boardroom-page">
    <content>
      <VBox class="sapUiSmallMargin boardroom-shell" width="100%">
        <ObjectHeader
          title="{project>/projectName}"
          number="{project>/projectId}"
          intro="Establish ownership, legal entities, countries and target setup before executing the proposal."
          backgroundDesign="Solid"/>

        <HBox class="sapUiTinyMarginTop" alignItems="Center">
          <Label text="Project name" class="sapUiSmallMarginEnd" width="140px"/>
          <Input id="projectNameInput" value="{project>/projectName}" width="320px"/>
        </HBox>

        <HBox class="sapUiTinyMarginTop" alignItems="Center">
          <Label text="Target country" class="sapUiSmallMarginEnd" width="140px"/>
          <Select selectedKey="{project>/country}" width="220px">
            <items>
              <core:Item key="DE" text="Germany"/>
              <core:Item key="US" text="United States"/>
              <core:Item key="FR" text="France"/>
            </items>
          </Select>
        </HBox>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Edit project" press=".onEditProject"/>
          <Button text="Legal entities" press=".onOpenLegalEntities"/>
          <Button text="Assign owners" press=".onAssignOwners"/>
          <Button text="Readiness check" type="Emphasized" press=".onReadinessCheck"/>
        </Toolbar>

        <HBox width="100%" class="sapUiMediumMarginTop">
          <VBox width="65%" class="sapUiSmallMarginEnd boardroom-panel">
            <Panel headerText="Project setup checklist">
              <VBox class="sapUiSmallMargin">
                <CheckBox text="Owner roles assigned" selected="true" enabled="false"/>
                <CheckBox text="Legal entities validated" selected="true" enabled="false"/>
                <CheckBox text="Target country and baseline confirmed" selected="true" enabled="false"/>
                <CheckBox text="Pre-launch governance review cleared" selected="false"/>
              </VBox>
            </Panel>
          </VBox>

          <VBox width="35%" class="boardroom-panel">
            <Panel headerText="Project summary">
              <VBox class="sapUiSmallMargin">
                <Text text="The project context is stable and aligned to the current transformation baseline. Remaining work is concentrated on governance review and final operational readiness."/>
              </VBox>
            </Panel>
          </VBox>
        </HBox>

        <Table items="{project>/legalEntities}" headerText="Legal entities" class="sapUiTinyMarginTop boardroom-panel">
          <columns>
            <Column><Text text="Entity ID"/></Column>
            <Column><Text text="Country"/></Column>
            <Column><Text text="Status"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{project>id}"/>
                <Text text="{project>country}"/>
                <ObjectStatus text="{project>status}" state="{project>state}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
