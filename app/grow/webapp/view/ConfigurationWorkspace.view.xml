<mvc:View
  controllerName="com.ey.grow.prototype.controller.ConfigurationWorkspace"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="configurationWorkspacePage" title="Configuration workspace" showNavButton="true" navButtonPress=".onBack">
    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <ObjectHeader
          title="{project>/projectName}"
          number="{project>/projectId}"
          intro="Resolve requirements to configuration activities and distinguish the activity identifier from its executable integration pathway."
          backgroundDesign="Solid"/>

        <Toolbar class="sapUiTinyMarginTop">
          <Button text="Generate values" press=".onGenerateValues"/>
          <Button text="Open activity" press=".onOpenActivity"/>
          <Button text="Filter pathway" press=".onFilterPathway"/>
          <Button text="Validate set" press=".onValidateSet"/>
          <Button text="Submit change set" type="Emphasized" press=".onSubmitChangeSet"/>
        </Toolbar>

        <MessageStrip
          class="sapUiSmallMarginTopBottom"
          type="{config>/bannerType}"
          showIcon="true"
          text="{config>/bannerText}"/>

        <Table id="configTable" items="{config>/activities}" mode="SingleSelectMaster" selectionChange=".onSelectActivity">
          <columns>
            <Column width="180px"><Text text="Activity"/></Column>
            <Column width="180px"><Text text="Target"/></Column>
            <Column width="180px"><Text text="Pathway"/></Column>
            <Column width="150px"><Text text="Status"/></Column>
            <Column><Text text="Owner"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation">
              <cells>
                <Text text="{config>activityId}"/>
                <Text text="{config>target}"/>
                <Text text="{config>pathway}"/>
                <ObjectStatus text="{config>status}" state="{config>statusState}"/>
                <Text text="{config>owner}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
