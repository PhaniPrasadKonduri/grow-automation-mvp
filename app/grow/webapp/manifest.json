{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.ey.grow.prototype",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "GROW Automation MVP",
    "description": "Prototype orchestration workspace for GROW Automation.",
    "applicationVersion": {
      "version": "0.1.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.ey.grow.prototype.view.App",
      "type": "XML",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.12",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.ui.unified": {},
        "sap.uxap": {}
      }
    },
    "models": {
      "": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "mainModel"
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.ey.grow.prototype.i18n.i18n"
        }
      },
      "screen": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
          "defaultBindingMode": "OneWay"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "com.ey.grow.prototype.view",
        "controlAggregation": "pages",
        "controlId": "app"
      },
      "routes": [
        { "pattern": "", "name": "P00", "target": "P00" },
        { "pattern": "demo", "name": "P00Route", "target": "P00" },
        { "pattern": "home", "name": "P01", "target": "P01" },
        { "pattern": "leadership", "name": "LeadershipOverview", "target": "LeadershipOverview" },
        { "pattern": "executive", "name": "ExecutiveLandingPage", "target": "ExecutiveLandingPage" },
        { "pattern": "phases", "name": "ProjectPhaseOverview", "target": "ProjectPhaseOverview" },
        { "pattern": "value", "name": "ValueImpactDashboard", "target": "ValueImpactDashboard" },
        { "pattern": "risk", "name": "RiskGovernanceBoard", "target": "RiskGovernanceBoard" },
        { "pattern": "operations", "name": "OperatingReadinessBoard", "target": "OperatingReadinessBoard" },
        { "pattern": "shared-controls", "name": "sharedControls", "target": "sharedControls" },
        { "pattern": "projects/{id}", "name": "P02", "target": "P02" },
        { "pattern": "projects/{id}/discover", "name": "P03", "target": "P03" },
        { "pattern": "projects/{id}/prepare", "name": "P04", "target": "P04" },
        { "pattern": "projects/{id}/integrations", "name": "P05", "target": "P05" },
        { "pattern": "projects/{id}/documents", "name": "P06", "target": "P06" },
        { "pattern": "projects/{id}/requirements", "name": "P07", "target": "P07" },
        { "pattern": "projects/{id}/processes", "name": "P08", "target": "P08" },
        { "pattern": "projects/{id}/scope", "name": "P09", "target": "P09" },
        { "pattern": "projects/{id}/scope/{scopeId}", "name": "P10", "target": "P10" },
        { "pattern": "projects/{id}/organization", "name": "P11", "target": "P11" },
        { "pattern": "projects/{id}/organization/{nodeId}", "name": "P12", "target": "P12" },
        { "pattern": "projects/{id}/configuration", "name": "P13", "target": "P13" },
        { "pattern": "projects/{id}/configuration/{activityId}", "name": "P14", "target": "P14" },
        { "pattern": "projects/{id}/agents/{runId}", "name": "P15", "target": "P15" },
        { "pattern": "projects/{id}/approvals", "name": "P16", "target": "P16" },
        { "pattern": "projects/{id}/approvals/{approvalId}", "name": "P17", "target": "P17" },
        { "pattern": "projects/{id}/packages/{packageId}", "name": "P18", "target": "P18" },
        { "pattern": "projects/{id}/deployments/{runId}", "name": "P19", "target": "P19" },
        { "pattern": "projects/{id}/reconciliation/{packageId}", "name": "P20", "target": "P20" },
        { "pattern": "projects/{id}/exceptions", "name": "P21", "target": "P21" },
        { "pattern": "projects/{id}/quality", "name": "P22", "target": "P22" },
        { "pattern": "projects/{id}/evidence", "name": "P23", "target": "P23" },
        { "pattern": "projects/{id}/run", "name": "P24", "target": "P24" },
        { "pattern": "projects/{id}/value", "name": "P25", "target": "P25" },
        { "pattern": "projects/{id}/access", "name": "P26", "target": "P26" },
        { "pattern": "projects/{id}/architecture", "name": "P27", "target": "P27" }
      ],
      "targets": {
        "P00": { "viewName": "DemoEntry", "viewLevel": 0 },
        "P01": { "viewName": "ExecutiveLandingPage", "viewLevel": 1 },
        "sharedControls": { "viewName": "SharedControls", "viewLevel": 1 },
        "P02": { "viewName": "RouteShell", "viewLevel": 2 },
        "P03": { "viewName": "RouteShell", "viewLevel": 3 },
        "P04": { "viewName": "PrepareProject", "viewLevel": 4 },
        "P05": { "viewName": "IntegrationControlCenter", "viewLevel": 5 },
        "P06": { "viewName": "DocumentIntake", "viewLevel": 6 },
        "P07": { "viewName": "RequirementsWorkbench", "viewLevel": 7 },
        "P08": { "viewName": "ProcessExplorer", "viewLevel": 8 },
        "P09": { "viewName": "ScopeReview", "viewLevel": 9 },
        "P10": { "viewName": "ScopeCandidateDetail", "viewLevel": 10 },
        "P11": { "viewName": "OrganizationDesigner", "viewLevel": 11 },
        "P12": { "viewName": "OrganizationNodeDetail", "viewLevel": 12 },
        "P13": { "viewName": "ConfigurationWorkspace", "viewLevel": 13 },
        "P14": { "viewName": "ConfigurationActivityDetail", "viewLevel": 14 },
        "P15": { "viewName": "RouteShell", "viewLevel": 15 },
        "P16": { "viewName": "RouteShell", "viewLevel": 16 },
        "P17": { "viewName": "RouteShell", "viewLevel": 17 },
        "P18": { "viewName": "DeploymentPackage", "viewLevel": 18 },
        "P19": { "viewName": "DeploymentExecutionMonitor", "viewLevel": 19 },
        "P20": { "viewName": "ReconciliationWorkspace", "viewLevel": 20 },
        "P21": { "viewName": "ExceptionQueue", "viewLevel": 21 },
        "P22": { "viewName": "QualityValidationWorkspace", "viewLevel": 22 },
        "P23": { "viewName": "EvidenceAuditExplorer", "viewLevel": 23 },
        "P24": { "viewName": "ExecutionRunOverview", "viewLevel": 24 },
        "P25": { "viewName": "ValueAndImpact", "viewLevel": 25 },
        "P26": { "viewName": "AccessAndEntitlements", "viewLevel": 26 },
        "P27": { "viewName": "ArchitectureAndApplicationMap", "viewLevel": 27 },
        "LeadershipOverview": { "viewName": "LeadershipOverview", "viewLevel": 1 },
        "ProjectPhaseOverview": { "viewName": "ProjectPhaseOverview", "viewLevel": 2 },
        "ValueImpactDashboard": { "viewName": "ValueImpactDashboard", "viewLevel": 2 },
        "RiskGovernanceBoard": { "viewName": "RiskGovernanceBoard", "viewLevel": 3 },
        "OperatingReadinessBoard": { "viewName": "OperatingReadinessBoard", "viewLevel": 4 }
      }
    }
  }
}
